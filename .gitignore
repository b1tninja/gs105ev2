# ---------------------------------------------------------------------------
# Vendor downloads — regenerate with scripts/download-firmware.ps1,
# never versioned. Allow-listed one path at a time, same pattern as
# the sibling mfc9330cdw/brother-firmware projects.
# ---------------------------------------------------------------------------
*.har
*.pcap
*.pcapng

downloads/**
!downloads/**/

!downloads/README.md
!downloads/firmware/README.md
!downloads/firmware/HASHES.md
!downloads/utilities/README.md
!downloads/utilities/HASHES.md
!downloads/meta/*.md

